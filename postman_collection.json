{
  "info": {
    "name": "TIHS CEMS API - Techno Institute of Higher Studies, Lucknow",
    "_postman_id": "cems-tihs-api-v1",
    "description": "Comprehensive REST API Collection for TIHS College Event Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"student@tihs.edu.in\",\n  \"password\": \"Student@123\",\n  \"role\": \"student\",\n  \"department\": \"BCA\",\n  \"year\": 3,\n  \"phone\": \"+91-7897123111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@tihs.edu.in\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-email"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tihs.edu.in\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events?category=All&status=published", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Get Single Event by Slug/ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events/technoutsav-2026-annual-cultural-fest", "host": ["{{baseUrl}}"], "path": ["api", "events", "technoutsav-2026-annual-cultural-fest"] }
          }
        },
        {
          "name": "Create Event (Faculty/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Summit 2026\",\n  \"description\": \"Generative AI workshops by industry leaders\",\n  \"category\": \"Technical\",\n  \"department\": \"BCA\",\n  \"startDate\": \"2026-10-15T10:00:00.000Z\",\n  \"endDate\": \"2026-10-15T17:00:00.000Z\",\n  \"venue\": \"TIHS Auditorium\",\n  \"capacity\": 150,\n  \"fee\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Approve Event (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "approve"] }
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register For Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team\": { \"isTeam\": false },\n  \"customResponses\": {}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/register", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "register"] }
          }
        },
        {
          "name": "Get My Registrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/registrations/me", "host": ["{{baseUrl}}"], "path": ["api", "registrations", "me"] }
          }
        }
      ]
    },
    {
      "name": "Attendance & Scanner",
      "item": [
        {
          "name": "Scan QR Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketCode\": \"TIHS-CUL-123456-101\",\n  \"method\": \"qr_scan\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendance/scan", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "scan"] }
          }
        }
      ]
    },
    {
      "name": "Admin & Analytics",
      "item": [
        {
          "name": "Get Analytics Data",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/analytics", "host": ["{{baseUrl}}"], "path": ["api", "admin", "analytics"] }
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" }
  ]
}
